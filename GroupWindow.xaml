<Window x:Class="DockManager.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        AllowDrop="True">

    <Window.Resources>

        <!-- ================================================= -->
        <!-- STILE PULSANTI DELLA DOCK                        -->
        <!-- ================================================= -->

        <Style x:Key="GroupButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#22FFFFFF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ================================================= -->
    <!-- SOTTO DOCK                                        -->
    <!-- ================================================= -->

    <Border x:Name="GroupBorder"
        Background="#EE202020"
        CornerRadius="16"
        Padding="10"
        BorderThickness="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AllowDrop="True">

        <StackPanel x:Name="GroupPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    AllowDrop="True"/>

    </Border>

</Window>