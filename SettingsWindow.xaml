<Window x:Class="DockManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni Dock"
        Width="430"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#202020"
        Foreground="White">

    <Window.Resources>

        <!-- TESTO -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- BUTTON -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="Background"
            Value="#303030"/>

            <Setter Property="Margin"
            Value="0,8,0,8"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground"
            Value="#8A8A8A"/>

            <Setter Property="Background"
            Value="#404040"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Impostazioni Dock"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Dimensione icone"
                       VerticalAlignment="Center"/>

            <Slider x:Name="IconSizeSlider"
                    Grid.Column="1"
                    Minimum="32"
                    Maximum="80"
                    TickFrequency="4"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>

            <TextBlock x:Name="IconSizeValue"
                       Grid.Column="2"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Spaziatura"
                       VerticalAlignment="Center"/>

            <Slider x:Name="SpacingSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="20"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>

            <TextBlock x:Name="SpacingValue"
                       Grid.Column="2"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ingrandimento Magnify"
                       VerticalAlignment="Center"/>

            <Slider x:Name="MagnifyMaximumSlider"
                    Grid.Column="1"
                    Minimum="1"
                    Maximum="2.5"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>

            <TextBlock x:Name="MagnifyMaximumValue"
                       Grid.Column="2"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Raggio Magnify"
                       VerticalAlignment="Center"/>

            <Slider x:Name="MagnifyRadiusSlider"
                    Grid.Column="1"
                    Minimum="50"
                    Maximum="250"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>

            <TextBlock x:Name="MagnifyRadiusValue"
                       Grid.Column="2"
                       TextAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Trasparenza Dock"
               VerticalAlignment="Center"/>

            <Slider x:Name="DockOpacitySlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="100"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                ValueChanged="DockOpacitySlider_ValueChanged"/>

            <TextBlock x:Name="DockOpacityValue"
               Grid.Column="2"
               TextAlignment="Right"
               VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Colore sfondo"
               VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
            Orientation="Horizontal">

                <Border x:Name="DockBackgroundPreview"
            Width="35"
            Height="25"
            Margin="0,0,8,0"
            BorderBrush="#666666"
            BorderThickness="1"
            MouseLeftButtonDown="DockBackgroundPreview_Click"/>

                <TextBox x:Name="DockBackgroundTextBox"
             Width="100"
             VerticalContentAlignment="Center"
             Padding="6,2"/>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="7" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Colore bordo"
               VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
            Orientation="Horizontal">

                <Border x:Name="DockBorderPreview"
            Width="35"
            Height="25"
            Margin="0,0,8,0"
            BorderBrush="#666666"
            BorderThickness="1"
            MouseLeftButtonDown="DockBorderPreview_Click"/>

                <TextBox x:Name="DockBorderTextBox"
             Width="100"
             VerticalContentAlignment="Center"
             Padding="6,2"/>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="8"
      Margin="0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Orientamento"
               VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                Orientation="Horizontal">

                <RadioButton x:Name="HorizontalRadioButton"
                     Content="Orizzontale"
                     GroupName="DockOrientation"
                     Foreground="White"
                     IsChecked="True"
                     Margin="0,0,20,0"/>

                <RadioButton x:Name="VerticalRadioButton"
                     Content="Verticale"
                     GroupName="DockOrientation"
                     Foreground="White"/>

            </StackPanel>

        </Grid>

        <StackPanel Grid.Row="9"
   VerticalAlignment="Center">

            <CheckBox x:Name="StartupCheckBox"
     Content="Avvia DockManager con Windows"
     Foreground="White"
     Background="White"
     Margin="0,10,0,10"/>

        </StackPanel>

        <StackPanel Grid.Row="11"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button Content="Annulla"
            Width="90"
            Margin="0,0,10,0"
            Click="Cancel_Click"/>

            <Button Content="Applica"
            Width="90"
            Click="Apply_Click"/>

        </StackPanel>

    </Grid>
</Window>